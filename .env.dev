APP__DEBUG=false
APP__ENV=development
APP__SERVICE=mod-apiparser
APP__VERSION=0.2.0
APP__PATH_DATA=secrets/data
APP__PATH_KEYS=secrets/keys

JWT__SECRET_KEY=default-secret-key
JWT__ALGORITHM=HS256

TOKEN__EXPIRATION_MINUTES=60


LOG_LEVEL=DEBUG
LOG_REDACTION=True
LOG_REDACTION_MODE=hash
LOG_SINK_STDOUT=true
LOG_SINK_STDERR=true
LOG_SINK_FILE=logs/app.log
LOG_SERIALIZATION=True
LOG_ENQUEUE=True
LOG_DIAGNOSE=True
LOG_FORMAT="<level>{level.name}</level>: <magenta>{name}:{function}:{line}</magenta> | {message} | {extra}"
